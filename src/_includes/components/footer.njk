{# Reusable Footer Component #}

<footer class="bg-slate-900 text-slate-300 pt-12 pb-8">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-10">
      <!-- Brand + Contact -->
      <div class="md:col-span-5">
        <a href="/image-cleaning/" class="inline-block">
          <img
            src="{{ '/assets/images/logo.svg' | url }}"
            alt="{{ site.name }}"
            class="h-8 w-auto brightness-200"
            width="160"
            height="36"
          />
        </a>
        <p class="mt-4 max-w-sm text-sm text-slate-400">
          Professional, reliable, and detail-obsessed cleaning for homes, offices, and vacation
          rentals across Savannah and the Lowcountry.
        </p>

        <div class="mt-6 space-y-2 text-sm">
          <a
            href="{{ site.phoneHref }}"
            class="flex items-center gap-2 hover:text-white transition"
          >
            <span class="font-semibold text-white">{{ site.phone }}</span>
          </a>
          <a href="mailto:{{ site.email }}" class="hover:text-white transition">{{ site.email }}</a>
          <div>{{ site.address.city }}, {{ site.address.state }}</div>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="md:col-span-3">
        <div class="font-semibold text-white mb-3 text-sm tracking-wider uppercase">Explore</div>
        <ul class="space-y-2 text-sm">
          {% for item in site.nav %}
          <li><a href="{{ item.url | url }}" class="hover:text-white transition">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Services -->
      <div class="md:col-span-4">
        <div class="font-semibold text-white mb-3 text-sm tracking-wider uppercase">
          Popular Services
        </div>
        <ul class="grid grid-cols-1 gap-y-1.5 text-sm">
          <li>
            <a href="{{ '/residential' | url }}" class="hover:text-white transition"
              >Residential House Cleaning</a
            >
          </li>
          <li>
            <a href="{{ '/vacation-rentals' | url }}" class="hover:text-white transition"
              >Airbnb &amp; Vrbo Turnover</a
            >
          </li>
          <li>
            <a href="{{ '/commercial' | url }}" class="hover:text-white transition"
              >Office &amp; Commercial Janitorial</a
            >
          </li>
          <li>
            <a href="{{ '/residential' | url }}" class="hover:text-white transition"
              >Move-In / Move-Out Cleans</a
            >
          </li>
          <li><a href="{{ '/about' | url }}" class="hover:text-white transition">Eco-Friendly Options</a></li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 pt-8 border-t border-slate-800 flex flex-col md:flex-row md:items-center gap-y-3 text-xs text-slate-500"
    >
      <div>© {{ year }} {{ site.name }}. All rights reserved.</div>
      <div class="md:ml-auto">
        <span>Locally owned &amp; operated in Savannah, GA</span>
      </div>
    </div>
  </div>
</footer>
